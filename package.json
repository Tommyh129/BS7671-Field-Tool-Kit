{
  "name": "react-example",
  "private": true,
  "version": "1.1.2",
  "type": "module",
  "scripts": {
    "test": "node --import ./scripts/register-test-loader.mjs --test tests/electrical.test.mjs tests/dc-cable.test.mjs tests/business.test.mjs tests/branding.test.mjs tests/invoices.test.mjs tests/subscriptions.test.mjs tests/invoiced-licences.test.mjs tests/rams.test.mjs && node --import ./scripts/business-test-loader.mjs --test tests/business-store.test.mjs && npm run test:privacy",
    "typecheck": "tsc -p tsconfig.app.json --noEmit",
    "typecheck:server": "tsc -p tsconfig.server.json --noEmit",
    "check:release-assets": "node scripts/check-release-assets.mjs",
    "test:privacy": "node --import ./scripts/register-test-loader.mjs --test tests/privacy.test.mjs && node --import ./scripts/business-test-loader.mjs --test tests/privacy-cache.test.mjs",
    "test:rams": "node --import ./scripts/register-test-loader.mjs --test tests/rams.test.mjs",
    "audit:electrical": "node --import ./scripts/register-test-loader.mjs scripts/check-electrical-coverage.mjs",
    "dev": "tsx server.ts",
    "build": "vite build --configLoader runner",
    "build:server": "node scripts/build-server.mjs",
    "build:full": "npm run build && npm run build:server",
    "start": "node build/server/server.cjs",
    "assets:generate": "capacitor-assets generate && node scripts/fix-pwa-manifest-icon-types.mjs",
    "postinstall": "node scripts/patch-android-gradle-compat.mjs && node scripts/patch-purchase-android-subscriptions.mjs && node scripts/patch-purchase-spm.mjs",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@capacitor-firebase/authentication": "^7.2.0",
    "@capacitor/android": "^7.0.0",
    "@capacitor/app": "^7.0.0",
    "@capacitor/browser": "^7.0.0",
    "@capacitor/core": "^7.0.0",
    "@capacitor/filesystem": "^7.0.0",
    "@capacitor/haptics": "^7.0.0",
    "@capacitor/ios": "^7.0.0",
    "@capacitor/share": "^7.0.0",
    "@google/genai": "^1.51.0",
    "better-sqlite3": "^12.4.1",
    "capacitor-plugin-purchase": "^0.1.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^4.21.2",
    "firebase": "^11.4.0",
    "firebase-admin": "^14.0.0",
    "google-auth-library": "10.6.2",
    "html-to-image": "^1.11.11",
    "jspdf": "^3.0.0",
    "lucide-react": "^0.477.0",
    "motion": "^12.23.24",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "stripe": "^20.4.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^7.0.0",
    "@tailwindcss/vite": "^4.1.14",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.20",
    "esbuild": "^0.28.1",
    "eslint": "^9.21.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "fake-indexeddb": "^6.2.4",
    "globals": "^15.15.0",
    "postcss": "^8.5.3",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.23.0",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.25.0",
    "vite": "^6.2.0"
  }
}
