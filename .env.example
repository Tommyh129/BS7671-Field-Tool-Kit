# Legacy Stripe management and webhooks only. New web checkout is disabled.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...

# App URLs (Used for Stripe redirects and webhooks)
# Public URL for redirects; native API calls use the same existing Cloud Run service.
APP_URL=https://the-sparkys-mate-29962838005.europe-west1.run.app
VITE_APP_URL=https://the-sparkys-mate-29962838005.europe-west1.run.app
VITE_API_BASE_URL=https://the-sparkys-mate-29962838005.europe-west1.run.app

# Native in-app purchase product IDs
# These must match the subscription product IDs in App Store Connect and Google Play Console.
VITE_PRO_PRODUCT_ID=pro_subscription
VITE_IOS_PRO_PRODUCT_ID=pro_subscription
VITE_ANDROID_PRO_PRODUCT_ID=pro_subscription
VITE_PRO_PRODUCT_ID_ALIASES=
VITE_BUSINESS_PRODUCT_ID=business_subscription
VITE_IOS_BUSINESS_PRODUCT_ID=business_subscription
VITE_ANDROID_BUSINESS_PRODUCT_ID=business_subscription

# Cloud Run only: Apple IAP verification credentials are separate from client config.
IOS_BUNDLE_ID=com.bs7671.fieldtoolkit
IOS_PRO_PRODUCT_ID=pro_subscription
IOS_BUSINESS_PRODUCT_ID=business_subscription
APPLE_IAP_KEY_ID=
APPLE_IAP_ISSUER_ID=
APPLE_IAP_PRIVATE_KEY=
# Enable only on TestFlight/sandbox test backend configuration when required.
APPLE_IAP_ALLOW_SANDBOX=false
# Grant the backend service account Play Developer subscription verification access first.
ANDROID_PACKAGE_NAME=com.bs7671.fieldtoolkit
ANDROID_PRO_PRODUCT_ID=pro_subscription
ANDROID_BUSINESS_PRODUCT_ID=business_subscription
PLAY_BILLING_VERIFICATION_ENABLED=false

# Temporary Android-only on-device billing panel. Never enable for a public release.
VITE_ANDROID_BILLING_DIAGNOSTICS=false

# Server-side regulatory update lookup
GEMINI_API_KEY=...
GEMINI_MODEL=gemini-2.5-flash

# Public HTTPS links from Termly > Publish > URL. Rebuild web/native assets after changing.
# Leave blank to use the in-app fallback. Never put Termly API keys in VITE_* variables.
VITE_PRIVACY_POLICY_URL=
VITE_TERMS_URL=
VITE_PRIVACY_REQUEST_URL=
VITE_DATA_PROCESSING_TERMS_URL=
VITE_PRIVACY_CONTACT_EMAIL=

# Local browser preview only. Also requires development mode and a loopback host.
VITE_SANDBOX_BUSINESS_ACCESS=false

# Server-only shared business file budget (default 100 MiB). Not a marketed tier allowance.
# Includes existing business files, invoice originals, RAMS PDFs and attachments.
BUSINESS_STORAGE_LIMIT_BYTES=104857600
